# "fix" is an unreleased commit. govulncheck still lists it because the advisory
# uses wildcard symbols (openpgp/*), so it matches on the module alone.
# Re-check after adding plugins (expect no output):
#   grep -a -o 'golang.org/x/crypto/openpgp[a-z0-9/]*' caddy | sort -u
